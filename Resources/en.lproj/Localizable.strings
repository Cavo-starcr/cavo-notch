"any moment" = "any moment";
"tomorrow" = "tomorrow";
"in %d min" = "in %d min";
"in %d h" = "in %d h";
"in %d h %d min" = "in %d h %d min";
"in %d d" = "in %d d";

/* Saved screenshots. The key is the date format itself, so a language can put
   the parts in its own order. */
